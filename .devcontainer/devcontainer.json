{
  "name": "ladesa-web",
  "build": {
    "dockerfile": "../.docker/Containerfile",
    "context": ".",
    "target": "devcontainer"
  },
  "workspaceFolder": "/workspaces/web",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/web,type=bind",
  "containerEnv": {
    "NPM_CONFIG_STORE_DIR": "/pnpm/store"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Vue.volar",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
