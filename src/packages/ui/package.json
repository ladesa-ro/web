{
  "name": "@ladesa-ro/web.ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "pnpm run clean && pnpm run build:types && vite build",
    "build:types": "vue-tsc --declaration --emitDeclarationOnly",
    "typecheck": "vue-tsc --noEmit && vue-tsc --noEmit -p tsconfig.dev.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@vueuse/core": "^14.3.0",
    "dayjs": "^1.11.21",
    "maska": "^3.2.0",
    "reka-ui": "^2.9.8",
    "rrule": "^2.8.1",
    "vue3-dropzone": "^2.2.1"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@ladesa-ro/web.styles": "workspace:*",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/vue3-vite": "^10.6.0",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/browser": "^5.0.0",
    "@vitest/browser-playwright": "^5.0.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.8.0",
    "playwright": "^1.63.0",
    "storybook": "^10.6.0",
    "typescript": "6.0.3",
    "vite": "^7.0.0",
    "vitest": "^5.0.0",
    "vue": "^3.5.35",
    "vue-component-type-helpers": "^3.3.11",
    "vue-tsc": "^3.0.0"
  }
}
