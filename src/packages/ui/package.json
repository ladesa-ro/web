{
  "name": "@ladesa-ro/web.ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "pnpm run clean && pnpm run build:types && vite build",
    "build:types": "vue-tsc --declaration --emitDeclarationOnly",
    "typecheck": "vue-tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.2",
    "@vueuse/core": "^14.3.0",
    "dayjs": "^1.11.21",
    "maska": "^3.2.0",
    "reka-ui": "^2.9.8",
    "vue3-dropzone": "^2.2.1"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/tsconfig": "^0.8.0",
    "typescript": "6.0.3",
    "vite": "^7.0.0",
    "vue": "^3.5.35",
    "vue-tsc": "^3.0.0"
  }
}
