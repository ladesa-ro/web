{
  "extends": [
    "@vue/tsconfig/tsconfig.dom.json",
    "@vue/tsconfig/tsconfig.lib.json"
  ],
  "include": ["src/**/*.ts", "src/**/*.vue"],
  "exclude": ["src/**/*.stories.ts", "src/**/*.test.ts"],
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "./dist/types",
    "rootDir": "./src",
    "types": ["web-bluetooth"]
  }
}
